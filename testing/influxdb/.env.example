# Telegraf Toolkit — isolated InfluxDB integration test environment (example)
#
# Copy to `.env` in this directory and adjust. `.env` is Git-ignored; only this
# `*.example` template is tracked. Values here are NON-SECRET configuration.
# Credentials are NOT set here — they are generated into ./secrets by
# scripts/init-secrets.sh (see README.md).

# Host loopback ports (never bind these to 0.0.0.0 for this test stack).
INFLUXDB2_PORT=18086
INFLUXDB3_PORT=18181

# InfluxDB 2 OSS initial org/bucket. Retention "0s" means infinite.
INFLUXDB2_ORG=ttk-test-org
INFLUXDB2_BUCKET=ttk-test-bucket
INFLUXDB2_RETENTION=0s

# InfluxDB 3 Core node identifier (prefix for object-store paths).
INFLUXDB3_NODE_ID=ttk-test-node

# Compose project name (keeps this stack isolated from other projects).
COMPOSE_PROJECT_NAME=telegraf-toolkit-influxdb-test

# Host UID/GID the containers run as. Defaults are supplied by the scripts;
# set explicitly only if you need to override. Find yours with `id -u`/`id -g`.
# HOST_UID=1000
# HOST_GID=1000
