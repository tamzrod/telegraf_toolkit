# Node / frontend
node_modules/
ui/dist/
ui/coverage/
*.local
*.tsbuildinfo

# Go
backend/bin/

# Local control-plane metadata store (ADR-0002). Never commit a database file;
# it is runtime state and must not carry secrets or be shared between hosts.
backend/data/
*.db
*.db-wal
*.db-shm

# Provisioned master key files (ADR-0003). Keys are provisioned outside the
# application and outside Git; a committed key is a security incident.
*.key
backend/keys/

# Authentication token files. Tokens are secrets; never commit them.
tokens.json
backend/tokens/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local toolchain / env
.env
.env.*

# Isolated InfluxDB 2 / InfluxDB 3 integration testing
# Track reproducible Compose files, fixtures, scripts and safe *.example templates.
# Ignore only locally generated state, secrets and artifacts.
testing/influxdb/.env
testing/influxdb/.env.*
!testing/influxdb/.env.example
testing/influxdb/secrets/
testing/influxdb/data/
testing/influxdb/volumes/
testing/influxdb/logs/
testing/influxdb/tmp/
testing/influxdb/artifacts/
testing/influxdb/reports/
testing/influxdb/*.token
testing/influxdb/*.key
testing/influxdb/*.pem
testing/influxdb/*credentials*.json
testing/influxdb/*secrets*.json
